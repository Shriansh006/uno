# Optional. If these are missing, the app falls back to an in-memory store
# (fine for local dev, but state is lost on restart and not shared across
# serverless instances — use Redis in production).

# Vercel's Upstash Redis / KV integration injects these automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or point at an Upstash database directly:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
